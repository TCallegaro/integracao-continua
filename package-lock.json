name: CI

on:
  push:
    branches: ["main"]
  pull_request:
    branches: ["main"]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Instalar dependências
        run: npm install

      - name: Build — validar estrutura do projeto
        run: |
          test -f index.html
          test -f css/styles.css
          test -f js/app.js
          echo "✅ Estrutura da SPA OK"

      - name: Build — validar sintaxe do JavaScript
        run: npm run build
